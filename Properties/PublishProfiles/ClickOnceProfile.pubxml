<?xml version="1.0" encoding="utf-8"?>
<!--
  ClickOnce profile for Phext Notepad.
  The GitHub Actions workflow (publish-clickonce.ps1) overrides the version,
  install URL, output folder, and signing on each publish.
  https://go.microsoft.com/fwlink/?LinkID=208121.
-->
<Project>
  <PropertyGroup>
    <ApplicationRevision>1</ApplicationRevision>
    <ApplicationVersion>0.4.4.*</ApplicationVersion>
    <BootstrapperEnabled>True</BootstrapperEnabled>
    <Configuration>Release</Configuration>
    <CreateDesktopShortcut>True</CreateDesktopShortcut>
    <CreateWebPageOnPublish>False</CreateWebPageOnPublish>
    <ExcludeDeploymentUrl>False</ExcludeDeploymentUrl>
    <GenerateManifests>true</GenerateManifests>
    <Install>True</Install>
    <InstallFrom>Web</InstallFrom>
    <InstallUrl>https://wbic16.github.io/phext-notepad/</InstallUrl>
    <IsRevisionIncremented>True</IsRevisionIncremented>
    <IsWebBootstrapper>True</IsWebBootstrapper>
    <MapFileExtensions>True</MapFileExtensions>
    <OpenBrowserOnPublish>False</OpenBrowserOnPublish>
    <Platform>Any CPU</Platform>
    <ProductName>Phext Notepad</ProductName>
    <PublishDir>artifacts\clickonce\</PublishDir>
    <PublisherName>Phext, Inc.</PublisherName>
    <PublishProtocol>ClickOnce</PublishProtocol>
    <PublishReadyToRun>False</PublishReadyToRun>
    <PublishSingleFile>False</PublishSingleFile>
    <PublishUrl>artifacts\clickonce\</PublishUrl>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>True</SelfContained>
    <SignatureAlgorithm>(none)</SignatureAlgorithm>
    <SignManifests>False</SignManifests>
    <SkipPublishVerification>false</SkipPublishVerification>
    <SupportUrl>https://github.com/wbic16/phext-notepad</SupportUrl>
    <TargetFramework>net10.0-windows8.0</TargetFramework>
    <UpdateEnabled>True</UpdateEnabled>
    <UpdateMode>Foreground</UpdateMode>
    <UpdateRequired>False</UpdateRequired>
    <UpdateUrl>https://wbic16.github.io/phext-notepad/</UpdateUrl>
    <WebPageFileName>index.html</WebPageFileName>
  </PropertyGroup>
</Project>
