{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Phext Notepad",
  "version": "0.5.0",
  "identifier": "io.phext.notepad",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Phext Notepad",
        "width": 1100,
        "height": 760,
        "minWidth": 720,
        "minHeight": 480,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self'; script-src 'self'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "Editor for 11-dimensional plain hypertext",
    "longDescription": "Phext Notepad opens, edits, and saves .phext files. The outline zooms between library.shelf.series, collection.volume.book, and chapter.section.scroll.",
    "fileAssociations": [
      {
        "ext": ["phext"],
        "name": "Phext",
        "description": "Plain Hypertext",
        "mimeType": "text/plain",
        "role": "Editor"
      }
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
